<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!--
  org.tokkl.Timer1 at /org/tokkl/Timer1 on the session bus. Timer, chain and
  Pomodoro session state is the server's, so changes from any device show
  here. Every property emits PropertiesChanged when its value changes.
-->
<node>
  <interface name="org.tokkl.Timer1">
    <!-- An entry is running. An open pomodoro is not one: it leaves Running
         false and SessionActive true. -->
    <property name="Running" type="b" access="read"/>
    <!-- Deprecated, use LocalStartTime. The running entry's start on the
         server's clock, Unix seconds, or 0. -->
    <property name="StartTime" type="x" access="read">
      <annotation name="org.freedesktop.DBus.Deprecated" value="true"/>
    </property>
    <!-- The running entry's start on this machine's clock (corrected by the
         last server_time), Unix seconds, or 0. Elapsed = now - this. -->
    <property name="LocalStartTime" type="x" access="read"/>
    <!-- A chain is paused: Running is false, StartTime is 0, and Resume
         continues it. -->
    <property name="Paused" type="b" access="read"/>
    <!-- Seconds stored for the entries the chain's pauses stopped; 0 without
         a chain. Elapsed time is this plus the running entry's own time. -->
    <property name="ChainSeconds" type="x" access="read"/>
    <!-- Project indicator for ChosenProject: "none" (no project or a removed
         one), "pending" (still being read) or "project". -->
    <property name="IndicatorState" type="s" access="read"/>
    <!-- The project's colour as lowercase #rrggbb in the "project" state,
         otherwise empty. -->
    <property name="IndicatorColor" type="s" access="read"/>
    <!-- The workspace's active projects: id (x), name (s), clientName (s),
         color (s), billable (b). -->
    <property name="Projects" type="aa{sv}" access="read">
      <annotation name="org.qtproject.QtDBus.QtTypeName" value="QList&lt;QVariantMap&gt;"/>
    </property>
    <!-- The workspace has more active projects than Projects holds. -->
    <property name="ProjectsIncomplete" type="b" access="read"/>
    <!-- The running or paused entry's project, or the next start's while
         stopped; 0 for none. Sessions from other devices do not change it. -->
    <property name="ChosenProject" type="x" access="read"/>
    <!-- Deprecated, use ChosenProjectLabel. The name of ChosenProject, also
         when archived; empty for none, pending or a removed project. -->
    <property name="ChosenProjectName" type="s" access="read">
      <annotation name="org.freedesktop.DBus.Deprecated" value="true"/>
    </property>
    <!-- Label of ChosenProject: kind (s) "none", "unknown", "unavailable" or
         "named" (read other values as "unknown"); missing (b) iff "unavailable";
         name (s), client (s), archived (b), set only when kind is "named". -->
    <property name="ChosenProjectLabel" type="a{sv}" access="read">
      <annotation name="org.qtproject.QtDBus.QtTypeName" value="QVariantMap"/>
    </property>
    <!-- The running or paused entry's billable flag, or the next start's. -->
    <property name="Billable" type="b" access="read"/>
    <!-- "unconfigured", "loading", "ready", "busy", "stale",
         "authentication-blocked" or "error". -->
    <property name="Status" type="s" access="read"/>
    <!-- Why Status is "error", "stale" or "authentication-blocked", for the
         user; empty otherwise. Never contains a secret. -->
    <property name="ErrorString" type="s" access="read"/>

    <!-- Pomodoro mode is on: idle left-clicks start sessions and Start is
         refused. Stored on this device. -->
    <property name="PomodoroMode" type="b" access="read"/>
    <!-- The mode cannot change: an entry runs, a chain is paused, or a
         session is active. -->
    <property name="ModeLocked" type="b" access="read"/>
    <!-- A Pomodoro session is active on the server, from any device. -->
    <property name="SessionActive" type="b" access="read"/>
    <!-- StartSession (and Start) can send now: mode allows it, nothing runs,
         the account may write, a state was read, and no action is pending. -->
    <property name="CanStartSession" type="b" access="read"/>
    <!-- The running phase: "work", "shortRest" or "longRest"; empty without
         a session. -->
    <property name="Phase" type="s" access="read"/>
    <!-- Start and planned end of the phase, Unix seconds; 0 without a
         session. Clients count down to PlannedEnd themselves. -->
    <property name="PhaseStart" type="x" access="read"/>
    <property name="PlannedEnd" type="x" access="read"/>
    <!-- Work phases of this round so far, counting the running one (a rest
         counts the work before it). 0 without a session. -->
    <property name="PomodoroNumber" type="i" access="read"/>
    <!-- Work phases per round for this session; 0 without a session. -->
    <property name="LongRestEvery" type="i" access="read"/>
    <!-- The phase NextPhase would start, named as Phase; empty without a
         session. -->
    <property name="UpcomingPhase" type="s" access="read"/>
    <!-- The planned end has passed and the phase has not changed. Stays true
         until a state shows another phase or no session. -->
    <property name="Ringing" type="b" access="read"/>
    <!-- "workToShortRest", "shortRestToWork", "workToLongRest" or
         "longRestToWork"; empty while not ringing. -->
    <property name="RingingTransition" type="s" access="read"/>
    <!-- The last user message about the session or timer, such as why an
         action failed; empty when none. Kept until the next action or message. -->
    <property name="SessionMessage" type="s" access="read"/>
    <!-- Keys run, startSession, nextPhase, endSession, project, billable, mode,
         each with visible (b), enabled (b) and label (s): "start"/"stop", the
         UpcomingPhase, "project[Running|Paused]", "pomodoroMode[Locked]" or the key. -->
    <property name="Actions" type="a{sa{sv}}" access="read">
      <annotation name="org.qtproject.QtDBus.QtTypeName" value="QMap&lt;QString,QVariantMap&gt;"/>
    </property>
    <!-- work, shortRest, longRest (minutes) and longRestEvery; the last known
         values while offline, the defaults without an account. -->
    <property name="PomodoroLengths" type="a{si}" access="read">
      <annotation name="org.qtproject.QtDBus.QtTypeName" value="QMap&lt;QString,int&gt;"/>
    </property>
    <!-- The account is connected, so SetPomodoroLengths can send. -->
    <property name="PomodoroLengthsEditable" type="b" access="read"/>
    <!-- Server messages for refused lengths, keyed as PomodoroLengths, plus
         "general". The next SetPomodoroLengths clears them. -->
    <property name="PomodoroLengthErrors" type="a{ss}" access="read">
      <annotation name="org.qtproject.QtDBus.QtTypeName" value="QMap&lt;QString,QString&gt;"/>
    </property>
    <!-- min, max and default (i) per length, keyed as PomodoroLengths, from
         the server's pomodoro_limits. Before the server announces them,
         1 to 999 with the offline defaults, and the lengths cannot be saved. -->
    <property name="PomodoroLengthLimits" type="a{sa{si}}" access="read">
      <annotation name="org.qtproject.QtDBus.QtTypeName" value="QMap&lt;QString,QMap&lt;QString,int&gt;&gt;"/>
    </property>
    <!-- The sound id from SoundChoices for each RingingTransition name. -->
    <property name="Sounds" type="a{ss}" access="read">
      <annotation name="org.qtproject.QtDBus.QtTypeName" value="QMap&lt;QString,QString&gt;"/>
    </property>
    <!-- Playable sounds, each with id (s) and label (s), in display order. -->
    <property name="SoundChoices" type="aa{sv}" access="read">
      <annotation name="org.qtproject.QtDBus.QtTypeName" value="QList&lt;QVariantMap&gt;"/>
    </property>
    <!-- summary (as) and menuLine (as): ordered part keys from "activity",
         "session", "project", "connection", "detail", "pomodoroMode",
         "message"; mark (s): "none", "pending", "alert" or "unconfigured". -->
    <property name="Presentation" type="a{sv}" access="read">
      <annotation name="org.qtproject.QtDBus.QtTypeName" value="QVariantMap"/>
    </property>
    <!-- Why the last ring or preview sound did not play, for the user; empty
         when it played. Kept until the next ring or preview. -->
    <property name="AlarmError" type="s" access="read"/>
    <!-- Interface version. 2 is the first release; each release that adds
         members adds one. Members are never removed or changed. -->
    <property name="InterfaceVersion" type="u" access="read"/>

    <!-- Deprecated, use RequestStart. Start an entry on ChosenProject with
         Billable; false when nothing was sent. -->
    <method name="Start">
      <arg name="sent" type="b" direction="out"/>
      <annotation name="org.freedesktop.DBus.Deprecated" value="true"/>
    </method>
    <!-- Deprecated, use RequestStop. Stop the entry and end the chain (a
         paused chain is discarded); false when nothing was sent. -->
    <method name="Stop">
      <arg name="sent" type="b" direction="out"/>
      <annotation name="org.freedesktop.DBus.Deprecated" value="true"/>
    </method>
    <!-- Deprecated, use RequestPause. Stop the entry and keep the chain
         paused; false when nothing was sent. -->
    <method name="Pause">
      <arg name="sent" type="b" direction="out"/>
      <annotation name="org.freedesktop.DBus.Deprecated" value="true"/>
    </method>
    <!-- Deprecated, use RequestResume. Start a clone of the paused entry;
         false when nothing was sent. -->
    <method name="Resume">
      <arg name="sent" type="b" direction="out"/>
      <annotation name="org.freedesktop.DBus.Deprecated" value="true"/>
    </method>
    <!-- Start, Stop, Pause and Resume as trackable requests. Return the
         request id, or 0 when nothing was sent; RequestFinished reports the
         outcome. Ids are not reused while the service runs. -->
    <method name="RequestStart">
      <arg name="request" type="t" direction="out"/>
    </method>
    <method name="RequestStop">
      <arg name="request" type="t" direction="out"/>
    </method>
    <method name="RequestPause">
      <arg name="request" type="t" direction="out"/>
    </method>
    <method name="RequestResume">
      <arg name="request" type="t" direction="out"/>
    </method>
    <!-- A Request* call ended, after its property changes. ok is true when
         the server applied it; otherwise error is the user message, empty if
         another account was configured meanwhile. -->
    <signal name="RequestFinished">
      <arg name="request" type="t"/>
      <arg name="ok" type="b"/>
      <arg name="error" type="s"/>
    </signal>
    <!-- Choose the next start's project (0 for none) and apply its billable
         default. False while an entry runs or a chain is paused, or for a
         project that is not active in the workspace. -->
    <method name="SetProject">
      <arg name="projectId" type="x" direction="in"/>
      <arg name="accepted" type="b" direction="out"/>
    </method>
    <!-- Set billable for the next start and any running entry. False while
         a chain is paused. -->
    <method name="SetBillable">
      <arg name="billable" type="b" direction="in"/>
      <arg name="accepted" type="b" direction="out"/>
    </method>
    <!-- Connect to an instance. authMode "token" or "password" (needs email);
         an empty secret keeps the stored one. Errors: InvalidArgs, Error.CredentialStore,
         Error.Superseded (a later Configure won and this one was not applied). -->
    <method name="Configure">
      <arg name="instanceUrl" type="s" direction="in"/>
      <arg name="authMode" type="s" direction="in"/>
      <arg name="email" type="s" direction="in"/>
      <arg name="secret" type="s" direction="in"/>
    </method>
    <!-- Timer mode (false) or Pomodoro mode (true). False while ModeLocked or
         when the choice cannot be stored. -->
    <method name="SetPomodoroMode">
      <arg name="pomodoro" type="b" direction="in"/>
      <arg name="accepted" type="b" direction="out"/>
    </method>
    <!-- The panel's left-click: confirm a ringing phase, toggle the timer, or
         start a session. Returns "handled", "open-menu" (a session runs
         before its planned end) or "ignored". -->
    <method name="Activate">
      <arg name="action" type="s" direction="out"/>
    </method>
    <!-- Start a session with ChosenProject and Billable when CanStartSession
         is true; false when nothing was sent. -->
    <method name="StartSession">
      <arg name="sent" type="b" direction="out"/>
    </method>
    <!-- Confirm the next phase against the state shown; the server saves the
         ended pomodoro. False without a session or while an action is pending. -->
    <method name="NextPhase">
      <arg name="sent" type="b" direction="out"/>
    </method>
    <!-- End the session against the state shown; the server saves or drops
         the open pomodoro. False without a session or while an action is pending. -->
    <method name="EndSession">
      <arg name="sent" type="b" direction="out"/>
    </method>
    <!-- Save the lengths, sending only values that differ. False while not
         editable, while a save runs, or when nothing differs; refusals show
         in PomodoroLengthErrors. -->
    <method name="SetPomodoroLengths">
      <arg name="work" type="i" direction="in"/>
      <arg name="shortRest" type="i" direction="in"/>
      <arg name="longRest" type="i" direction="in"/>
      <arg name="longRestEvery" type="i" direction="in"/>
      <arg name="sent" type="b" direction="out"/>
    </method>
    <!-- Read the lengths from the server again. -->
    <method name="RefreshPreferences"/>
    <!-- Call before showing Projects: rereads them only if the server says
         they changed. No-op while a check runs, without an account, or after
         the workspace is lost. -->
    <method name="RefreshProjects"/>
    <!-- Choose a transition's sound. InvalidArgs for an unknown transition or
         sound id; false when the choice cannot be stored. -->
    <method name="SetSound">
      <arg name="transition" type="s" direction="in"/>
      <arg name="soundId" type="s" direction="in"/>
      <arg name="accepted" type="b" direction="out"/>
    </method>
    <!-- Play a sound once. InvalidArgs for an unknown sound id; otherwise
         true, and a playback failure shows in AlarmError. -->
    <method name="PreviewSound">
      <arg name="soundId" type="s" direction="in"/>
      <arg name="accepted" type="b" direction="out"/>
    </method>
  </interface>
</node>
