<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!--
  org.tokkl.Timer1: the Tokkl timer of tokkl-timerd, at /org/tokkl/Timer1 on
  the session bus. The service runs the shared desktop core and adds no rule
  of its own. The running entry, the pause chain and the Pomodoro session are
  the server's: a change made on any device shows here, in either mode. Every
  property emits
  org.freedesktop.DBus.Properties.PropertiesChanged with its new value when
  it changes.
-->
<node>
  <interface name="org.tokkl.Timer1">
    <!-- An entry is running. The open pomodoro of a session is not a
         timer: it leaves Running false and SessionActive true. -->
    <property name="Running" type="b" access="read"/>
    <!-- Start of the running entry as the server recorded it, as Unix time
         in seconds, or 0. On a machine whose clock differs from the
         server's, the current time minus this is off by the difference:
         use LocalStartTime for elapsed time. Kept for older clients. -->
    <property name="StartTime" type="x" access="read"/>
    <!-- StartTime on this machine's clock: the server's start minus how far
         the server's clock is ahead of this one, as the server_time of the
         last state read gives it. Unix time in seconds, or 0. The running
         entry's own time is the current time minus this, the same as the
         other Tokkl apps show. -->
    <property name="LocalStartTime" type="x" access="read"/>
    <!-- A chain is paused: nothing runs, so Running is false and StartTime
         is 0, and Resume would continue it. -->
    <property name="Paused" type="b" access="read"/>
    <!-- The seconds the server stored for the entries the chain's pauses
         stopped; 0 without a chain. Elapsed time is this plus the running
         entry's own time, and this alone while paused. -->
    <property name="ChainSeconds" type="x" access="read"/>
    <!-- What the project indicator shows for ChosenProject: "none" (no
         project, or the instance no longer has it), "pending" (its details
         are still being read) or "project". -->
    <property name="IndicatorState" type="s" access="read"/>
    <!-- The project's colour as lowercase #rrggbb in the "project" state,
         otherwise empty. -->
    <property name="IndicatorColor" type="s" access="read"/>
    <!-- The active projects of the workspace, each with id (x), name (s),
         clientName (s), color (s) and billable (b). -->
    <property name="Projects" type="aa{sv}" access="read">
      <annotation name="org.qtproject.QtDBus.QtTypeName" value="QList&lt;QVariantMap&gt;"/>
    </property>
    <!-- The workspace has more active projects than the service could read,
         so Projects is only the first of them. A project menu says so, as
         the KDE and macOS menus do. -->
    <property name="ProjectsIncomplete" type="b" access="read"/>
    <!-- The running or paused entry's project, or the project of the next
         start while stopped; 0 for no project. A session started on another
         device does not change it. -->
    <property name="ChosenProject" type="x" access="read"/>
    <!-- The name of ChosenProject, also when the running entry's project is
         archived and so missing from Projects. Empty for no project, while
         the project is still being read, and for a project the instance no
         longer has. -->
    <property name="ChosenProjectName" type="s" access="read"/>
    <!-- The running or paused entry's billable flag, or that of the next
         start. -->
    <property name="Billable" type="b" access="read"/>
    <!-- "unconfigured", "loading", "ready", "busy", "stale",
         "authentication-blocked" or "error". -->
    <property name="Status" type="s" access="read"/>
    <!-- Why Status is "error", "stale" or "authentication-blocked", for the
         user; empty otherwise. It never contains a secret. -->
    <property name="ErrorString" type="s" access="read"/>

    <!-- Pomodoro mode is on: with nothing running, left-clicks start
         Pomodoro sessions instead of timer entries, and Start is refused.
         The service stores the mode on this device, so it survives a
         restart. -->
    <property name="PomodoroMode" type="b" access="read"/>
    <!-- The mode cannot change: an entry runs, a chain is paused, or a
         session is active. -->
    <property name="ModeLocked" type="b" access="read"/>
    <!-- A Pomodoro session is active on the server, whichever device
         started it and in either mode. A restart reads it again. -->
    <property name="SessionActive" type="b" access="read"/>
    <!-- StartSession can send now: Pomodoro mode is on, nothing runs, no
         session is active, an account is connected and may write (no 429
         cooldown, workspace not lost), and a state has been read from the
         server. False while an action waits for its answer or its outcome
         is not known yet. Start follows the same rule. -->
    <property name="CanStartSession" type="b" access="read"/>
    <!-- The phase that runs: "work", "shortRest" or "longRest"; empty
         without a session. -->
    <property name="Phase" type="s" access="read"/>
    <!-- Start and planned end of the phase as Unix time in seconds; 0
         without a session. Clients count down to PlannedEnd themselves:
         the remaining time is not published. -->
    <property name="PhaseStart" type="x" access="read"/>
    <property name="PlannedEnd" type="x" access="read"/>
    <!-- Work phases of this round: the one that runs counts, and a rest
         counts the work phase before it. 0 without a session. -->
    <property name="PomodoroNumber" type="i" access="read"/>
    <!-- Work phases per round, from the lengths the session started with;
         0 without a session. -->
    <property name="LongRestEvery" type="i" access="read"/>
    <!-- The kind of phase the NextPhase method would start, as Phase
         names it; empty without a session. -->
    <property name="UpcomingPhase" type="s" access="read"/>
    <!-- The planned end has passed and the phase has not changed since. It
         stays true until a state shows another phase or no session, also
         when the app starts after the planned end and while the instance is
         unreachable. -->
    <property name="Ringing" type="b" access="read"/>
    <!-- The transition that rings: "workToShortRest", "shortRestToWork",
         "workToLongRest" or "longRestToWork"; empty while not ringing. -->
    <property name="RingingTransition" type="s" access="read"/>
    <!-- The last message about the session or the timer for the user: why
         an action failed, such as a connection error or "The timer changed
         on another device first.", or that a pomodoro was too short to
         save. Empty when there is none; it stays until the next action or
         the next message. -->
    <property name="SessionMessage" type="s" access="read"/>
    <!-- Which timer and session actions a menu shows and can choose, from
         the shared core's rules with the GNOME policy: Start, Stop, Project
         and Billable wait for Status "ready", and a session leaves Project
         and Billable as the timer allows. The keys are run, startSession,
         nextPhase, endSession, project, billable and mode, each with
         visible (b), enabled (b) and label (s). enabled is false whenever
         visible is. The label names the text to show: "start" or "stop"
         for run, the phase NextPhase would start for nextPhase (as
         UpcomingPhase names it), "project", or "projectRunning" or
         "projectPaused" while a held entry locks it, for project,
         "pomodoroMode" or "pomodoroModeLocked" for mode, and the key
         itself otherwise. The methods still refuse what does not apply. -->
    <property name="Actions" type="a{sa{sv}}" access="read">
      <annotation name="org.qtproject.QtDBus.QtTypeName" value="QMap&lt;QString,QVariantMap&gt;"/>
    </property>
    <!-- The account's Pomodoro lengths: work, shortRest and longRest in
         minutes, and longRestEvery in work phases per round. The last
         known lengths while the account is unreachable; the defaults
         without an account. -->
    <property name="PomodoroLengths" type="a{si}" access="read">
      <annotation name="org.qtproject.QtDBus.QtTypeName" value="QMap&lt;QString,int&gt;"/>
    </property>
    <!-- The account is connected, so SetPomodoroLengths can send. -->
    <property name="PomodoroLengthsEditable" type="b" access="read"/>
    <!-- The server's message for each length it refused, keyed as
         PomodoroLengths, and under "general" a failed read or a refusal
         that names no length. Only refused keys are present; the next
         SetPomodoroLengths clears them. -->
    <property name="PomodoroLengthErrors" type="a{ss}" access="read">
      <annotation name="org.qtproject.QtDBus.QtTypeName" value="QMap&lt;QString,QString&gt;"/>
    </property>
    <!-- The range and default of each length the server accepts, keyed as
         PomodoroLengths, each with min, max and default (i), so a settings
         pane offers what SetPomodoroLengths can save. It does not change
         while the service runs. A service from before this property has
         none: a client then keeps the limits it had built in. -->
    <property name="PomodoroLengthLimits" type="a{sa{si}}" access="read">
      <annotation name="org.qtproject.QtDBus.QtTypeName" value="QMap&lt;QString,QMap&lt;QString,int&gt;&gt;"/>
    </property>
    <!-- The sound each transition plays when it rings: the four transition
         names of RingingTransition, each with an id from SoundChoices. -->
    <property name="Sounds" type="a{ss}" access="read">
      <annotation name="org.qtproject.QtDBus.QtTypeName" value="QMap&lt;QString,QString&gt;"/>
    </property>
    <!-- The sounds a transition can play, each with id (s) and label (s),
         in the order a settings pane lists them. -->
    <property name="SoundChoices" type="aa{sv}" access="read">
      <annotation name="org.qtproject.QtDBus.QtTypeName" value="QList&lt;QVariantMap&gt;"/>
    </property>
    <!-- Which parts a client's words for the state show, in order, as the
         core's StatusPresentation decides them with the GNOME policy:
         summary (as) for the button's accessible name and menuLine (as) for
         the menu's status line, each a list of "activity", "session",
         "project", "connection", "detail", "pomodoroMode" and "message";
         and mark (s), how the button's time ends: "none", "pending",
         "alert" or "unconfigured". A client turns the keys into its own
         words and leaves out a part it has no words for. A service from
         before this property has none: a client then decides the parts as
         it did before. -->
    <property name="Presentation" type="a{sv}" access="read">
      <annotation name="org.qtproject.QtDBus.QtTypeName" value="QVariantMap"/>
    </property>
    <!-- Why the last alarm sound did not play, a ring's or a
         PreviewSound's, in words for the user: a missing file, or a sound
         server that refused it. Empty when it played. It stays after the
         ring ends, until the next ring or preview starts. A service from
         before this property has none. -->
    <property name="AlarmError" type="s" access="read"/>

    <!-- Start a new entry on ChosenProject with Billable. Returns false
         when nothing was sent: an entry runs, a chain is paused, a session
         is active, a request is in flight, the account is not ready, or
         Pomodoro mode is on. -->
    <method name="Start">
      <arg name="sent" type="b" direction="out"/>
    </method>
    <!-- Stop the running entry and end the chain. While paused it asks the
         server to discard the chain, which needs a connection. Returns false
         when nothing was sent, also while a session is active. -->
    <method name="Stop">
      <arg name="sent" type="b" direction="out"/>
    </method>
    <!-- Stop the running entry and keep the chain paused, so Resume can
         continue it. Returns false when nothing was sent, also while a
         session is active. -->
    <method name="Pause">
      <arg name="sent" type="b" direction="out"/>
    </method>
    <!-- Start a clone of the paused entry: its description, project, task,
         tags and billable flag. Returns false when nothing was sent, also
         while a session is active. A refused resume leaves the chain
         paused. -->
    <method name="Resume">
      <arg name="sent" type="b" direction="out"/>
    </method>
    <!-- Start, Stop, Pause and Resume as requests a caller can follow to
         their end. Each does what the method of the same action does and
         returns the request's id, or 0 when nothing was sent, for the same
         reasons as that method. RequestFinished carries the id once the
         server has answered. Ids are never reused while the service runs.
         The methods without Request keep their meaning. -->
    <method name="RequestStart">
      <arg name="request" type="t" direction="out"/>
    </method>
    <method name="RequestStop">
      <arg name="request" type="t" direction="out"/>
    </method>
    <method name="RequestPause">
      <arg name="request" type="t" direction="out"/>
    </method>
    <method name="RequestResume">
      <arg name="request" type="t" direction="out"/>
    </method>
    <!-- A request from RequestStart, RequestStop, RequestPause or
         RequestResume has ended, after the properties it changed. ok is
         true when the server applied it. Otherwise error says why for the
         user, as ErrorString words it: a refusal, a change made on another
         device first, an answer that never came (the service then reads
         the state to learn what happened), or a lost workspace. error is
         empty when another account was configured before the answer came. -->
    <signal name="RequestFinished">
      <arg name="request" type="t"/>
      <arg name="ok" type="b"/>
      <arg name="error" type="s"/>
    </signal>
    <!-- Choose the project of the next start; 0 for no project. Applies the
         project's billable default. Refused (false) while an entry runs or a
         chain is paused, and for a project that is not an active project of
         the workspace. -->
    <method name="SetProject">
      <arg name="projectId" type="x" direction="in"/>
      <arg name="accepted" type="b" direction="out"/>
    </method>
    <!-- Choose billable for the next start; while an entry runs, also edit
         that entry. Refused (false) while a chain is paused. -->
    <method name="SetBillable">
      <arg name="billable" type="b" direction="in"/>
      <arg name="accepted" type="b" direction="out"/>
    </method>
    <!-- Connect to an instance. authMode is "token" or "password"; email is
         needed for "password". A nonempty secret is saved in the credential
         store first; an empty one keeps what the store holds for that
         account. Fails with org.freedesktop.DBus.Error.InvalidArgs for
         unusable settings, and with org.tokkl.Timer1.Error.CredentialStore
         when the store refuses the secret; the settings then stay as they
         were. Fails with org.tokkl.Timer1.Error.Superseded when another
         Configure call came while the store saved this one's secret: the
         later call's settings are the ones applied, and this call's never
         were, so a client must not keep them as accepted. A service from
         before that error answered such a call with success. -->
    <method name="Configure">
      <arg name="instanceUrl" type="s" direction="in"/>
      <arg name="authMode" type="s" direction="in"/>
      <arg name="email" type="s" direction="in"/>
      <arg name="secret" type="s" direction="in"/>
    </method>
    <!-- Switch between Timer mode (false) and Pomodoro mode (true).
         Refused (false) while ModeLocked, and when the choice cannot be
         stored. -->
    <method name="SetPomodoroMode">
      <arg name="pomodoro" type="b" direction="in"/>
      <arg name="accepted" type="b" direction="out"/>
    </method>
    <!-- The panel's left-click. While a session is active, in either mode,
         it confirms the next phase while Ringing and otherwise returns
         "open-menu". With no session, while an entry runs or a chain is
         paused, and always in Timer mode, it is the timer's toggle: it
         pauses a running entry, resumes a paused chain, and otherwise
         starts an entry. In Pomodoro mode it starts a session when there is
         none. Returns "handled", "open-menu" (a session runs before its
         planned end: the client opens its menu) or "ignored" (nothing
         applied: no account, no state read yet, or an action waits for its
         answer or its outcome). -->
    <method name="Activate">
      <arg name="action" type="s" direction="out"/>
    </method>
    <!-- Start a session on the server with ChosenProject and Billable; the
         server takes the account's lengths and starts at its own clock.
         Allowed when CanStartSession is true. Returns false when nothing was
         sent. -->
    <method name="StartSession">
      <arg name="sent" type="b" direction="out"/>
    </method>
    <!-- Confirm the next phase on the server, before or after the planned
         end, against the state shown. The server saves the ended pomodoro.
         Returns false without a session and while an action waits for its
         answer or its outcome. -->
    <method name="NextPhase">
      <arg name="sent" type="b" direction="out"/>
    </method>
    <!-- End the session on the server, against the state shown. The server
         saves the open pomodoro, or drops it when too short. Returns false
         without a session and while an action waits for its answer or its
         outcome. -->
    <method name="EndSession">
      <arg name="sent" type="b" direction="out"/>
    </method>
    <!-- Save the account's lengths: work, short rest and long rest in
         minutes, and work phases per round. Only the values that differ
         from PomodoroLengths are sent. Returns false while not editable,
         while a save runs, and when nothing differs. A refused value shows
         in PomodoroLengthErrors. -->
    <method name="SetPomodoroLengths">
      <arg name="work" type="i" direction="in"/>
      <arg name="shortRest" type="i" direction="in"/>
      <arg name="longRest" type="i" direction="in"/>
      <arg name="longRestEvery" type="i" direction="in"/>
      <arg name="sent" type="b" direction="out"/>
    </method>
    <!-- Read the lengths from the server again. -->
    <method name="RefreshPreferences"/>
    <!-- Choose the sound a transition plays. Fails with
         org.freedesktop.DBus.Error.InvalidArgs for a transition or a sound
         id the service does not know. Returns false when the choice cannot
         be stored. -->
    <method name="SetSound">
      <arg name="transition" type="s" direction="in"/>
      <arg name="soundId" type="s" direction="in"/>
      <arg name="accepted" type="b" direction="out"/>
    </method>
    <!-- Play a sound once, for a settings pane. Fails with
         org.freedesktop.DBus.Error.InvalidArgs for a sound id the service
         does not know. Returns false when the service has no player. -->
    <method name="PreviewSound">
      <arg name="soundId" type="s" direction="in"/>
      <arg name="accepted" type="b" direction="out"/>
    </method>
  </interface>
</node>
