# The widget's QML imports are loaded at run time, so dpkg-shlibdeps cannot
# see them. On TUXEDO OS the org.kde.plasma.* QML modules (plasmoid, core,
# components, configuration) are in plasma-desktoptheme.
Depends: plasma-desktoptheme (>= 6.6.0~),
         qml6-module-org-kde-kcmutils (>= 6.24.0~),
         qml6-module-org-kde-kirigami (>= 6.24.0~),
         qml6-module-qtqml (>= 6.10.0~),
