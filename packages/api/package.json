{
  "name": "@tokkl/api",
  "version": "0.1.0",
  "private": true,
  "description": "The Tokkl HTTP server: Toggl Track compatible API, web app API and static web root, shipped as raw TypeScript",
  "type": "module",
  "scripts": {
    "test": "node --test --test-reporter=spec 'test/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json",
    "test:storage:migrations": "node --test --test-reporter=spec test/storage/migrations.test.ts test/storage/migrationLifecycle.test.ts test/storage/legacyPreflight.test.ts",
    "test:storage:transactions": "node --test --test-reporter=spec test/storage/transactions.test.ts test/storage/transactionsConcurrency.test.ts"
  },
  "dependencies": {
    "@tokkl/common": "0.1.0",
    "@tokkl/types": "0.1.0",
    "express": "^5.3.0",
    "kysely": "0.29.7",
    "mysql2": "3.24.6",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/pg": "8.23.1"
  }
}
