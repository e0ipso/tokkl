{
  "name": "timetrack",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted, single-user time tracker with a Toggl Track compatible API",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch packages/api/src/index.ts",
    "dev:web": "vite --config packages/web/vite.config.ts",
    "build": "vite build --config packages/web/vite.config.ts",
    "start": "node packages/api/src/index.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/web/tsconfig.json && tsc -p e2e/tsconfig.json && tsc -p scripts/tsconfig.json",
    "test": "node --test --test-reporter=spec 'packages/*/**/*.test.ts'",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:install": "playwright install --only-shell chromium",
    "bench:history": "npm run build && node bench/history.ts",
    "screenshots": "npm run build && playwright test --config scripts/screenshots.config.ts",
    "icons": "node scripts/icons.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
