{
  "name": "tokkl",
  "version": "1.9.0",
  "private": true,
  "description": "Self-hosted time tracker with a Toggl Track compatible API",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch packages/api/src/index.ts",
    "dev:web": "vite --config packages/web/vite.config.ts",
    "build": "npm run build --workspaces --if-present",
    "start": "node packages/api/src/index.ts",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p e2e/tsconfig.json && tsc -p scripts/tsconfig.json && tsc -p bench/tsconfig.json && tsc -p desktop/kde/tests/tsconfig.json && tsc -p desktop/gnome/extension/ci/tsconfig.json",
    "test": "npm run test --workspaces --if-present && node --test --test-reporter=spec 'e2e/**/*.test.ts' 'scripts/**/*.test.ts' 'desktop/gnome/extension/**/*.test.js'",
    "check:tracker-refs": "node scripts/check-tracker-refs.ts",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:install": "playwright install --only-shell chromium",
    "bench:history": "npm run build && node bench/history.ts",
    "screenshots": "npm run build && playwright test --config scripts/screenshots.config.ts",
    "icons": "node scripts/icons.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/is-ignored": "^21.2.3",
    "@commitlint/lint": "^21.2.3",
    "@commitlint/load": "^21.2.3",
    "@playwright/test": "^1.64.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@types/node": "^24.0.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "husky": "^9.1.7",
    "semantic-release": "^25.0.9",
    "typescript": "^5.9.3"
  }
}
